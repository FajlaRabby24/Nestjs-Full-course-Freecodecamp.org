// ==============================================================================================
// 🟢 STEP 3.4 of 11: MESSAGE MODEL DEFINITION
// ==============================================================================================
// Stores chat messages with smart routing references:
//  - If `roomId` is present -> Message belongs to a public channel
//  - If `recipientId` is present -> Message is a 1-on-1 private direct message
//
// 👉 NEXT STEP: Open "src/prisma/prisma.service.ts" (STEP 4 of 11) for the NestJS database service.
// ==============================================================================================

model Message {
  id          String   @id @default(uuid())
  content     String
  senderId    String
  roomId      String?  // Nullable: Set for group/channel messages
  recipientId String?  // Nullable: Set for 1-on-1 direct messages
  createdAt   DateTime @default(now())

  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User?    @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: SetNull)
  room        Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
}
