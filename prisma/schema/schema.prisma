// ==============================================================================================
// 🟢 STEP 3.1 of 11: PRISMA MULTI-FILE SCHEMA CONFIGURATION (PRISMA 7)
// ==============================================================================================
// Configures Prisma to use multi-file schema folder structure and PostgreSQL.
// In Prisma 7+, datasource URL is configured in "prisma.config.ts" and multi-file schema is standard.
//
// 👉 PREVIOUS STEP: "src/app.module.ts" (STEP 2 of 11)
// 👉 RELATED FILES: "prisma/schema/user.prisma", "room.prisma", "message.prisma", "prisma.config.ts"
// 👉 NEXT STEP: Open "src/prisma/prisma.service.ts" (STEP 4 of 11) for the NestJS database service.
// ==============================================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
